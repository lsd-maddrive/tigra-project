<?xml version="1.0"?>
<launch>

    <node pkg="tf2_ros" type="static_transform_publisher"
        name="base_footprint_2_base_link"
        args="
            0.0 0.0 0.25
            0.0 0.0 0.0
            /base_footprint /base_link" />

    <node pkg="tf2_ros" type="static_transform_publisher"
        name="base_link_2_gps_rover"
        args="
            0.0 0.0 3.0
            0.0 0.0 0.0
            /base_link /gps_rover" />

    <node pkg="tf2_ros" type="static_transform_publisher"
        name="base_link_2_gps_moving_base"
        args="
            0.0 0.0 3.0
            0.0 0.0 0.0
            /base_link /gps_moving_base" />

</launch>

<?xml version="1.0"?>
<launch>

    <arg name="rosbag_mode" default="play" doc="[play, record]"/>
    <arg name="rosbag_filename" default="rosbag_filename"/>

    <arg name="map_name" default="pepelac_test.db"/>
    <arg name="localization" default="false" doc="[false - slam]"/>
    <arg name="database_path" default="$(find tigra_maps)/3d_maps/$(arg map_name)"/>

    <arg name="rviz" default="false" />
    <arg name="mapviz" default="false" />
    <arg name="rtabmap_viz" default="false" />
    <arg name="foxglove" default="false" />

    <!-- playing rosbag -->
    <group if="$(eval arg('rosbag_mode') == 'play')">

        <node pkg="rosbag" type="play" name="rosbag_play" output="screen"
            args="
                --quiet
                --clock
                --topics
                    /tf_static
                    /yahboom/imu/raw
                    /yahboom/mag/raw
                    /simpleRTK2B_moving_base/fix
                    /simpleRTK2B_rover/navheading
                    /front_rs_d455_camera/infra1/image_rect_raw/compressed
                    /front_rs_d455_camera/infra2/image_rect_raw/compressed
                    /front_rs_d455_camera/infra1/camera_info
                    /front_rs_d455_camera/infra2/camera_info
                    /front_rs_d455_camera/color/image_raw/compressed
                    /front_rs_d455_camera/aligned_depth_to_color/image_raw/compressed
                    /front_rs_d455_camera/color/camera_info
                    /front_rs_d455_camera/imu/filtered
                    /front_lslidar_c16_lidar_point_cloud
                --bags
                    $(find tigra_software)/bags/$(arg rosbag_filename)_0.bag
                    "/>

        <node name="color_republish" pkg="image_transport" type="republish" args="compressed raw">
            <remap from="in" to="/front_rs_d455_camera/color/image_raw" />
            <remap from="out" to="/front_rs_d455_camera/color/image_raw" />
        </node>

        <node name="aligned_depth_to_color_republish" pkg="image_transport" type="republish" args="compressed raw">
            <remap from="in" to="/front_rs_d455_camera/aligned_depth_to_color/image_raw" />
            <remap from="out" to="/front_rs_d455_camera/aligned_depth_to_color/image_raw" />
            <param name="compressed/mode" value="color"/>
        </node>

        <!-- rtabmap_slam -->
        <include file="$(find tigra_vision)/launch/rtabmap_slam.launch">
            <arg name="lidar_name" default="front_lslidar_c16_lidar" />
            <arg name="publish_tf_map" default="true"/>
            <arg name="localization" value="$(arg localization)" />
            <arg name="database_path" value="$(arg database_path)" />
            <arg name="rtabmap_viz" value="$(arg rtabmap_viz)"/>
        </include>

        <!-- rgbd_odom -->
        <include file="$(find tigra_vision)/launch/rgbd_odom.launch">
            <arg name="publish_tf" value="true" />
            <arg name="camera_name" value="front_rs_d455_camera" />
            <arg name="subscribe_rgbd" value="false" />
        </include>

        <!-- http://wiki.ros.org/imu_filter_madgwick -->
        <!-- <node pkg="imu_filter_madgwick" type="imu_filter_node" name="imu_filter_node" output="screen">
            <param name="gain" value="0.5"/>
            <param name="world_frame" value="enu"/>
            <param name="use_mag" value="true"/>
            <param name="publish_tf" value="true"/>
            <param name="fixed_frame" value="imu_filtered_link"/>
            <param name="use_magnetic_field_msg" value="true"/>
            <param name="reverse_tf" value="true"/>

            <remap from="imu/data_raw" to="/yahboom/imu/raw"/>
            <remap from="imu/mag" to="/yahboom/mag/raw"/>
            <remap from="imu/data" to="/yahboom/imu/filtered"/>
        </node> -->

    </group>

    <!-- recording rosbag -->
    <group if="$(eval arg('rosbag_mode') == 'record')">

        <!-- tf_statis -->
        <!-- TF pepelac high is 0.8-->
        <node pkg="tf2_ros" type="static_transform_publisher"
            name="base_footprint_2_laser_link"
            args="
                0.0 0.0 1.02
                1.57 0.0 0.0
                /base_footprint /laser_link" />
        <node pkg="tf2_ros" type="static_transform_publisher"
            name="base_footprint_2_front_rs_d455_camera_link"
            args="
                0.0 0.0 1.15
                0.0 0.0 0.0
                /base_footprint /front_rs_d455_camera_link" />
        <node pkg="tf2_ros" type="static_transform_publisher"
            name="base_footprint_2_imu_raw_link"
            args="
                0.0 0.0 0.25
                0.0 0.0 0.0
                /base_footprint /imu_raw_link" />
        <node pkg="tf2_ros" type="static_transform_publisher"
            name="base_footprint_2_gps_rover"
            args="
                0.0 0.0 3.0
                0.0 0.0 0.0
                /base_footprint /gps_rover" />
        <node pkg="tf2_ros" type="static_transform_publisher"
            name="base_footprint_2_gps_moving_base"
            args="
                0.0 0.0 3.0
                0.0 0.0 0.0
                /base_footprint /gps_moving_base" />

        <!-- hardware -->
        <!-- lslidar_c16 -->
        <include file="$(find maddrive_hardware_tools)/launch/start_lslidar_c16.launch">
            <arg name="min_range" value="1.0" />  
            <arg name="topic_name" value="front_lslidar_c16_lidar_point_cloud" />  
        </include>
        <!-- rs_camera -->
        <include file="$(find maddrive_hardware_tools)/launch/start_rs_camera_ir.launch"/>
        <!-- yahboom_imu -->
        <include file="$(find maddrive_hardware_tools)/launch/yahboom_imu.launch">
            <arg name="port" value="/dev/tty_Yahboom0" />
            <arg name="baud" value="115200" />
            <arg name="frameId" value="imu_raw_link" />
            <arg name="imu_output_topic" value="/yahboom/imu/raw" />
            <arg name="mag_output_topic" value="/yahboom/mag/raw" />
            <arg name="rviz" value="false" />
        </include>
        <!-- simpleRTK2B_rover -->
        <node pkg="ublox_gps" type="ublox_gps" name="simpleRTK2B_rover"
            output="screen" clear_params="true" respawn="true">
            <rosparam command="load" file="$(find maddrive_hardware_tools)/config/gps/simpleRTK2B_rover.yaml" />
            <remap from="rtcm" to="simpleRTK2B_rover/rtcm"/>
        </node>
        <!-- simpleRTK2B_moving_base -->
        <node pkg="ublox_gps" type="ublox_gps" name="simpleRTK2B_moving_base"
            output="screen" clear_params="true" respawn="true">
            <rosparam command="load" file="$(find maddrive_hardware_tools)/config/gps/simpleRTK2B_moving_base.yaml" />
            <remap from="rtcm" to="simpleRTK2B_moving_base/rtcm"/>
        </node>

        <node pkg="rosbag" type="record" name="rosbag_record" output="screen"
            args="
                /tf_static
                /yahboom/imu/raw
                /yahboom/mag/raw
                /simpleRTK2B_moving_base/fix
                /simpleRTK2B_moving_base/fix_velocity
                /simpleRTK2B_moving_base/hp_fix
                /simpleRTK2B_moving_base/monhw
                /simpleRTK2B_moving_base/navclock
                /simpleRTK2B_moving_base/navheading
                /simpleRTK2B_moving_base/navhpposecef
                /simpleRTK2B_moving_base/navhpposllh
                /simpleRTK2B_moving_base/navposecef
                /simpleRTK2B_moving_base/navpvt
                /simpleRTK2B_moving_base/navrelposned
                /simpleRTK2B_moving_base/navsat
                /simpleRTK2B_moving_base/navstatus
                /simpleRTK2B_rover/fix
                /simpleRTK2B_rover/fix_velocity
                /simpleRTK2B_rover/hp_fix
                /simpleRTK2B_rover/monhw
                /simpleRTK2B_rover/navclock
                /simpleRTK2B_rover/navheading
                /simpleRTK2B_rover/navhpposecef
                /simpleRTK2B_rover/navhpposllh
                /simpleRTK2B_rover/navposecef
                /simpleRTK2B_rover/navpvt
                /simpleRTK2B_rover/navrelposned
                /simpleRTK2B_rover/navsat
                /simpleRTK2B_rover/navstatus
                /simpleRTK2B_rover/rtcm
                /simpleRTK2B_rover/rxmrtcm
                /front_rs_d455_camera/infra1/image_rect_raw/compressed
                /front_rs_d455_camera/infra2/image_rect_raw/compressed
                /front_rs_d455_camera/infra1/camera_info
                /front_rs_d455_camera/infra2/camera_info
                /front_rs_d455_camera/color/image_raw/compressed
                /front_rs_d455_camera/aligned_depth_to_color/image_raw/compressed
                /front_rs_d455_camera/color/camera_info
                /front_rs_d455_camera/imu/filtered
                /front_lslidar_c16_lidar_point_cloud
                --output-name $(find tigra_software)/bags/$(arg rosbag_filename).bag
                --split
                --size=10000
                "/>

    </group>

    <!-- rviz -->
    <group if="$(arg rviz)">
        <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find tigra_software)/config/rqt/rviz/pepelac_debug.rviz" /> -->
        <node name="rviz" pkg="rviz" type="rviz" args="-d $(find tigra_software)/config/rqt/rviz/full_slam_pepelac_view.rviz" />
    </group>

    <!-- mapviz -->
    <group if="$(arg mapviz)">
        <node pkg="mapviz" type="mapviz" name="mapviz">
            <param name="config" value="$(find tigra_software)/config/rqt/mapviz/pepelac.mvc"/>
        </node>
        <node pkg="swri_transform_util" type="initialize_origin.py" name="initialize_origin">
            <param name="local_xy_frame" value="base_footprint"/>
            <param name="local_xy_origin" value="auto"/>
            <remap from="fix" to="/moving_base/simpleRTK2B/navsat"/>
        </node>
    </group>

    <!-- foxglove -->
    <group if="$(arg foxglove)">
        <include file="$(find foxglove_bridge)/launch/foxglove_bridge.launch">
            <arg name="port" value="8765" />
        </include>
    </group>

    <!-- debug console -->
    <node name="swri_console" pkg="swri_console" type="swri_console" />

</launch>
